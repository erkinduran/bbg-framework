{
    "name": "erkinduran/bbg-framework",
    "description": "A minimal PHP micro-framework: array routing, PDO wrapper, plain-PHP views and global helpers.",
    "type": "project",
    "license": "MIT",
    "keywords": ["framework", "micro-framework", "router", "php"],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "erkinduran",
            "email": "erkinduran@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
